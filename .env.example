# Public URL of the Railway web service, without a trailing slash.
PUBLIC_BASE_URL=https://your-service.up.railway.app

# Required: create a development key at https://developers.giphy.com/dashboard/
GIPHY_API_KEY=

# Generated once per deployment. Use Railway's secret generator for both.
OWNER_CODE=
OAUTH_SIGNING_SECRET=

# Railway PostgreSQL reference variable.
DATABASE_URL=

# Railway Bucket reference variables (private S3-compatible storage).
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
ENDPOINT=

# Usually unnecessary. Set only if your S3-compatible provider returns signed
# URLs from a different origin than ENDPOINT or BUCKET.ENDPOINT.
STORAGE_PUBLIC_ORIGIN=
S3_FORCE_PATH_STYLE=false

# Optional local development settings.
PORT=8787
DATABASE_DRIVER=postgres
STORAGE_DRIVER=s3
